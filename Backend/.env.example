ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the default Claude model
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Comma-separated frontend origins. Keep this restrictive outside local development.
CORS_ORIGINS=http://localhost:5173
# Optional shared key. If set, clients must send it in the X-API-Key header.
# API_ACCESS_KEY=replace-with-a-long-random-value
# MAX_UPLOAD_BYTES=10485760
# MAX_QUERY_ROWS=500
